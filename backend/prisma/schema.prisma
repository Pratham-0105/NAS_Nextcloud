datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  USER
}

enum DeviceType {
  INTERNAL_SSD
  INTERNAL_HDD
  USB_SSD
  USB_HDD
  USB_FLASH
  NVME
  UNKNOWN
}

enum DeviceStatus {
  DETECTED
  INSPECTED
  AVAILABLE
  SELECTED
  REGISTERED
  MOUNTED
  ACTIVE
  UNAVAILABLE
  DEGRADED
  DISCONNECTED
  ERROR
}

enum EventSeverity {
  INFO
  WARNING
  CRITICAL
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  name            String
  passwordHash    String
  role            Role           @default(USER)
  nextcloudUser   String         @unique
  quotaBytes      BigInt?        // Null indicates unlimited
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  auditLogs       AuditLog[]
}

model StorageDevice {
  id              String         @id @default(uuid())
  deviceName      String         // e.g. "sdb", "sdb1"
  devicePath      String         @unique // e.g. "/dev/sdb"
  deviceModel     String?        // e.g. "Samsung Portable SSD T7"
  vendor          String?        // e.g. "Samsung", "Seagate"
  model           String?        // e.g. "SSD 980 PRO"
  serial          String?        // Hardware serial if accessible
  deviceType      DeviceType     @default(UNKNOWN)
  filesystem      String?        // e.g. "ext4", "exfat", "ntfs"
  uuid            String         @unique // Partition or disk UUID
  totalBytes      BigInt
  usedBytes       BigInt
  freeBytes       BigInt
  mountPoint      String?        // e.g. "/mnt/storage1"
  isRemovable     Boolean        @default(false)
  isRotational    Boolean        @default(false)
  isReadOnly      Boolean        @default(false)
  isSystemDisk    Boolean        @default(false) // Protected OS / application disk
  hasExistingData Boolean        @default(false)
  partitions      Json?          // Structured partition tree
  transport       String?        // e.g. "USB", "NVMe", "SATA", "Unknown"
  detectionSource String         @default("REAL_HARDWARE") // "REAL_HARDWARE" or "SIMULATION"
  poolPriority    Int            @default(1)
  isCloudStorage  Boolean        @default(false)
  status          DeviceStatus   @default(DETECTED)
  lastSeenAt      DateTime       @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  events          StorageEvent[]
  poolMembers     StoragePoolMember[]
}

enum StoragePoolStatus {
  CREATING
  ACTIVE
  DEGRADED
  UNAVAILABLE
  STOPPED
  ERROR
}

model StoragePool {
  id              String              @id @default(uuid())
  name            String              @unique
  status          StoragePoolStatus   @default(ACTIVE)
  mountPoint      String              @default("/mnt/storage_pool")
  totalBytes      BigInt              @default(0)
  usedBytes       BigInt              @default(0)
  freeBytes       BigInt              @default(0)
  filesystem      String              @default("mergerfs")
  poolingMethod   String              @default("MERGERFS") // "MERGERFS" or "VIRTUAL_POOL"
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  members         StoragePoolMember[]
  events          StoragePoolEvent[]
}

model StoragePoolMember {
  id              String         @id @default(uuid())
  poolId          String
  pool            StoragePool    @relation(fields: [poolId], references: [id], onDelete: Cascade)
  deviceId        String
  device          StorageDevice  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  mountPoint      String?
  status          String         @default("ACTIVE") // ACTIVE, DEGRADED, DISCONNECTED, REMOVED
  addedAt         DateTime       @default(now())
  removedAt       DateTime?
  lastSeenAt      DateTime       @default(now())

  @@unique([poolId, deviceId])
}

model StoragePoolEvent {
  id              String         @id @default(uuid())
  poolId          String
  pool            StoragePool    @relation(fields: [poolId], references: [id], onDelete: Cascade)
  severity        EventSeverity  @default(INFO)
  eventType       String         // e.g. "storage.pool.created", "storage.pool.member_added", "storage.pool.degraded", "storage.pool.recovered"
  message         String
  metadata        Json?
  timestamp       DateTime       @default(now())
}

model StorageEvent {
  id          String         @id @default(uuid())
  deviceId    String?
  device      StorageDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  severity    EventSeverity  @default(INFO)
  eventType   String         // e.g. "storage.device.detected", "storage.device.registered"
  message     String
  metadata    Json?
  timestamp   DateTime       @default(now())
}

model SystemMetric {
  id          Int           @id @default(autoincrement())
  cpuUsage    Float
  ramUsed     BigInt
  ramTotal    BigInt
  poolUsed    BigInt
  poolTotal   BigInt
  recordedAt  DateTime      @default(now())

  @@index([recordedAt])
}

model AuditLog {
  id          String        @id @default(uuid())
  userId      String?
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  ipAddress   String?
  details     Json?
  createdAt   DateTime      @default(now())
}

