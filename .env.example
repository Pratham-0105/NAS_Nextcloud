# ==============================================================================
# GLOBAL / ENVIRONMENT CONFIGURATION
# ==============================================================================
NODE_ENV=development

# ------------------------------------------------------------------------------
# DATABASE & CACHE
# ------------------------------------------------------------------------------
POSTGRES_USER=cloud_admin
POSTGRES_PASSWORD=supersecure_admin_password_change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
APP_DB_NAME=cloud_nas
NEXTCLOUD_DB_NAME=nextcloud

# Backend Connection URL (App DB)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${APP_DB_NAME}?schema=public

# Redis Connection URL
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# BACKEND API
# ------------------------------------------------------------------------------
PORT=4000
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_please_change
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://*.onrender.com

# ------------------------------------------------------------------------------
# NEXTCLOUD ENGINE (Internal & External)
# ------------------------------------------------------------------------------
NEXTCLOUD_INTERNAL_URL=http://localhost:8080
NEXTCLOUD_ADMIN_USER=ncadmin
NEXTCLOUD_ADMIN_PASSWORD=change_this_strong_nc_password

# ------------------------------------------------------------------------------
# STORAGE & HOST MANAGEMENT PATHS
# ------------------------------------------------------------------------------
# Mount path for pooled storage managed by mergerfs
STORAGE_POOL_PATH=/mnt/storage_pool
# Directory where detected individual physical disks are mounted
PHYSICAL_DEVICES_MOUNT_DIR=/mnt/devices
# Allow mock/simulation mode when developing on macOS or environments without root/lsblk
SIMULATE_STORAGE=true

# ------------------------------------------------------------------------------
# FRONTEND APPS (Public Environment Variables)
# ------------------------------------------------------------------------------
# Admin Portal (Port 3001)
NEXT_PUBLIC_ADMIN_PORT=3001
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:4000/api

# User Cloud Portal (Port 3002 - Deployable on Render)
NEXT_PUBLIC_USER_PORT=3002
NEXT_PUBLIC_USER_API_URL=http://localhost:4000/api
